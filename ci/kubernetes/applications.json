    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "governance-sync",
        "namespace": "bittensor-safe"
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 0,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "governance-sync"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "governance-sync"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "command": [
                  "python",
                  "manage.py",
                  "shell",
                  "-c",
                  "import sys; sys.path.insert(0, '/sync'); from continuous_sync import main; main()"
                ],
                "env": [
                  {
                    "name": "RUN_MIGRATIONS",
                    "value": "0"
                  },
                  {
                    "name": "WORKER_QUEUES",
                    "value": "default,indexing,processing,contracts,tokens,notifications,webhooks"
                  },
                  {
                    "name": "ETH_EVENTS_GET_LOGS_CONCURRENCY",
                    "value": "1"
                  },
                  {
                    "name": "ETHEREUM_NODE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "archive-rpc",
                        "key": "ETHEREUM_NODE_URL"
                      }
                    }
                  },
                  {
                    "name": "SYNC_RPC_INTERVAL_SECONDS",
                    "value": "1"
                  },
                  {
                    "name": "SYNC_POLL_SECONDS",
                    "value": "6"
                  }
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "txs"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "txs"
                    }
                  }
                ],
                "image": "ghcr.io/safe-global/safe-transaction-service:v5.42.1@sha256:5d177ed215decd3525c5757358076a88d24941ca54e2ee8c5afe80f52179b3d6",
                "imagePullPolicy": "IfNotPresent",
                "name": "sync",
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "-c",
                      "import json,time; d=json.load(open('/tmp/sync-health.json')); assert 0<=time.time()-d['checked_at']<90 and 0<=d['head_lag']<=6"
                    ]
                  },
                  "failureThreshold": 3,
                  "initialDelaySeconds": 30,
                  "periodSeconds": 15,
                  "successThreshold": 1,
                  "timeoutSeconds": 5
                },
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "memory": "1Gi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "memory": "512Mi"
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/sync",
                    "name": "sync-code",
                    "readOnly": true
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "enableServiceLinks": false,
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 60,
            "volumes": [
              {
                "configMap": {
                  "defaultMode": 420,
                  "name": "governance-sync-code"
                },
                "name": "sync-code"
              }
            ]
          }
        }
      }
    },
