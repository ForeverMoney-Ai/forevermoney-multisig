      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "safe",
        "namespace": "bittensor-safe",
        "annotations": {
          "cert-manager.io/issuer": "safe-letsencrypt",
          "nginx.ingress.kubernetes.io/proxy-body-size": "2m",
