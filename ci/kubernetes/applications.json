    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "name": "sync-alert",
        "namespace": "bittensor-safe"
      },
      "spec": {
        "concurrencyPolicy": "Forbid",
        "failedJobsHistoryLimit": 2,
        "jobTemplate": {
          "metadata": {},
          "spec": {
            "activeDeadlineSeconds": 55,
            "backoffLimit": 1,
            "template": {
              "metadata": {
                "labels": {
                  "app": "sync-alert"
                }
              },
              "spec": {
                "automountServiceAccountToken": false,
                "containers": [
                  {
                    "command": [
                      "python",
                      "-B",
                      "/code/monitor.py"
                    ],
                    "image": "python:3.12-alpine",
                    "imagePullPolicy": "IfNotPresent",
                    "name": "monitor",
                    "resources": {
                      "limits": {
                        "cpu": "100m",
                        "memory": "64Mi"
                      },
                      "requests": {
                        "cpu": "10m",
                        "memory": "32Mi"
                      }
                    },
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      },
                      "readOnlyRootFilesystem": true
                    },
                    "terminationMessagePath": "/dev/termination-log",
                    "terminationMessagePolicy": "File",
                    "volumeMounts": [
                      {
                        "mountPath": "/code",
                        "name": "code",
                        "readOnly": true
                      },
                      {
                        "mountPath": "/telegram",
                        "name": "telegram",
                        "readOnly": true
                      }
                    ]
                  }
                ],
                "dnsPolicy": "ClusterFirst",
                "restartPolicy": "Never",
                "schedulerName": "default-scheduler",
                "securityContext": {
                  "fsGroup": 1000,
                  "runAsGroup": 1000,
                  "runAsNonRoot": true,
                  "runAsUser": 1000,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "serviceAccount": "sync-alert",
                "serviceAccountName": "sync-alert",
                "terminationGracePeriodSeconds": 30,
                "volumes": [
                  {
                    "configMap": {
                      "defaultMode": 420,
                      "name": "sync-alert-code"
                    },
                    "name": "code"
                  },
                  {
                    "name": "telegram",
                    "secret": {
                      "defaultMode": 288,
                      "secretName": "sync-alert-telegram"
                    }
                  }
                ]
              }
            }
          }
        },
        "schedule": "* * * * *",
        "startingDeadlineSeconds": 40,
        "successfulJobsHistoryLimit": 1,
        "suspend": false
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "labels": {
          "app.kubernetes.io/part-of": "bittensor-safe"
        },
        "name": "price-proxy",
        "namespace": "bittensor-safe"
      },
      "spec": {
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "price-proxy"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "price-proxy"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "enableServiceLinks": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "price-proxy",
                "image": "python:3.12-alpine",
                "imagePullPolicy": "IfNotPresent",
                "command": [
                  "python",
                  "-B",
                  "/code/price_proxy.py"
                ],
                "ports": [
                  {
                    "containerPort": 8080,
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 2
                },
                "resources": {
                  "limits": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  },
                  "requests": {
                    "cpu": "10m",
                    "memory": "32Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "volumeMounts": [
                  {
                    "mountPath": "/code",
                    "name": "code",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "code",
                "configMap": {
                  "name": "price-proxy-code"
                }
              }
            ]
          }
        }
      }
