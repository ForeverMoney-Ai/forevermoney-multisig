{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "safe",
    "namespace": "bittensor-safe",
    "annotations": {
      "cert-manager.io/issuer": "safe-letsencrypt",
      "nginx.ingress.kubernetes.io/ssl-redirect": "true",
      "nginx.ingress.kubernetes.io/proxy-body-size": "2m"
    }
  },
  "spec": {
    "ingressClassName": "nginx",
    "tls": [
      {
        "hosts": [
          "safe.forevermoney.ai"
        ],
        "secretName": "safe-forevermoney-ai-tls"
      }
    ],
    "rules": [
      {
        "host": "safe.forevermoney.ai",
        "http": {
          "paths": [
            {
              "path": "/",
              "pathType": "Prefix",
              "backend": {
                "service": {
                  "name": "ui",
                  "port": {
                    "number": 8080
                  }
                }
              }
            }
          ]
        }
      }
    ]
  }
}
