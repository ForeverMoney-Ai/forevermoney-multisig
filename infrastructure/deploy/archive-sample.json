{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "archive-sample",
    "namespace": "bittensor-safe"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 600,
    "template": {
      "metadata": {
        "labels": {
          "app": "archive-sample"
        }
      },
      "spec": {
        "enableServiceLinks": false,
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "backfill",
            "image": "ghcr.io/safe-global/safe-transaction-service:v5.42.1@sha256:5d177ed215decd3525c5757358076a88d24941ca54e2ee8c5afe80f52179b3d6",
            "imagePullPolicy": "IfNotPresent",
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "512Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "1Gi"
              }
            },
            "command": [
              "python",
              "manage.py",
              "shell",
              "-c",
              "from safe_transaction_service.history.services import IndexServiceProvider; s=IndexServiceProvider(); a=['0xADF60fcC63217961c931d57f1dCE2C5d70Af3546']; print('SAMPLE_START',flush=True); n=s.reindex_master_copies(8786146,to_block_number=8796145,block_process_limit=1000,addresses=a); print('SAMPLE_COMPLETE events=',n,flush=True)"
            ],
            "envFrom": [
              {
                "configMapRef": {
                  "name": "txs"
                }
              },
              {
                "secretRef": {
                  "name": "txs"
                }
              },
              {
                "secretRef": {
                  "name": "archive-rpc"
                }
              }
            ],
            "env": [
              {
                "name": "RUN_MIGRATIONS",
                "value": "0"
              },
              {
                "name": "WORKER_QUEUES",
                "value": "default,indexing,processing,contracts,tokens,notifications,webhooks"
              }
            ]
          }
        ],
        "restartPolicy": "Never"
      }
    }
  }
}
