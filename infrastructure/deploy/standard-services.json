      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "txs",
        "namespace": "bittensor-safe",
        "labels": {
          "app.kubernetes.io/part-of": "bittensor-safe"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "txs"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "txs"
            }
          },
          "spec": {
            "enableServiceLinks": false,
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "txs",
                "image": "ghcr.io/safe-global/safe-transaction-service:v5.42.1@sha256:5d177ed215decd3525c5757358076a88d24941ca54e2ee8c5afe80f52179b3d6",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "768Mi"
                  }
                },
                "ports": [
                  {
                    "containerPort": 8888
                  }
                ],
                "command": [
                  "gunicorn",
                  "--config",
                  "gunicorn.conf.py",
                  "--bind",
                  "0.0.0.0:8888",
                  "config.wsgi:application"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "txs"
                    }
                  },
                  {
                    "secretRef": {
                      "name": "txs"
                    }
                  }
                ],
                "readinessProbe": {
                  "tcpSocket": {
                    "port": 8888
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10
                },
                "env": [
                  {
                    "name": "ETH_EVENTS_BLOCK_PROCESS_LIMIT",
                    "value": "1000"
                  },
                  {
                    "name": "ETH_EVENTS_BLOCK_PROCESS_LIMIT_MAX",
                    "value": "1000"
                  },
                  {
                    "name": "ETH_EVENTS_GET_LOGS_CONCURRENCY",
                    "value": "1"
                  },
                  {
                    "name": "RUN_MIGRATIONS",
                    "value": "0"
                  },
                  {
                    "name": "ETHEREUM_NODE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "archive-rpc",
                        "key": "ETHEREUM_NODE_URL"
                      }
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
