{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "governance-history-backfill",
    "namespace": "bittensor-safe"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 10800,
    "template": {
      "metadata": {
        "labels": {
          "app": "governance-history-backfill"
        }
      },
      "spec": {
        "enableServiceLinks": false,
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "backfill",
            "image": "ghcr.io/safe-global/safe-transaction-service:v5.42.1@sha256:5d177ed215decd3525c5757358076a88d24941ca54e2ee8c5afe80f52179b3d6",
            "imagePullPolicy": "IfNotPresent",
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "512Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "1Gi"
              }
            },
            "command": [
              "python",
              "manage.py",
              "shell",
              "-c",
              "from safe_transaction_service.history.services import IndexServiceProvider\nfrom safe_transaction_service.history.models import MultisigTransaction\ns=IndexServiceProvider()\na=['0xADF60fcC63217961c931d57f1dCE2C5d70Af3546']\nstop=s.ethereum_client.current_block_number-20\nprint('BACKFILL_START governance from=8786146 to='+str(stop),flush=True)\nn=s.reindex_master_copies(8786146,to_block_number=stop,block_process_limit=1000,addresses=a)\nprint('SAFE_EVENTS_COMPLETE events='+str(n),flush=True)\ns.reprocess_addresses(a)\nn=s.reindex_erc20_events(8786146,to_block_number=stop,block_process_limit=1000,addresses=a)\nprint('TOKEN_EVENTS_COMPLETE events='+str(n),flush=True)\nprint('BACKFILL_COMPLETE through='+str(stop),flush=True)\n"
            ],
            "envFrom": [
              {
                "configMapRef": {
                  "name": "txs"
                }
              },
              {
                "secretRef": {
                  "name": "txs"
                }
              },
              {
                "secretRef": {
                  "name": "archive-rpc"
                }
              }
            ],
            "env": [
              {
                "name": "RUN_MIGRATIONS",
                "value": "0"
              },
              {
                "name": "WORKER_QUEUES",
                "value": "default,indexing,processing,contracts,tokens,notifications,webhooks"
              }
            ]
          }
        ],
        "restartPolicy": "Never"
      }
    }
  }
}
